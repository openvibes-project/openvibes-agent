# TEMPLATE ONLY: move to .github/workflows/ci.yml after the Cargo workspace
# exists, pin every action placeholder to a reviewed full commit SHA, and set
# the actual Cargo binary name below.
name: CI & Security Guardrails

on:
  workflow_dispatch:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main, develop ]

env:
  CARGO_TERM_COLOR: always
  RUSTFLAGS: "-D warnings -F unsafe-code"

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # =========================================================================
  # JOB 1: Security Audit & Linting (Fast Feedback)
  # =========================================================================
  security-and-lint:
    name: Security Audit & Code Hygiene
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout repository
        # TEMPLATE: replace tags with reviewed full commit SHAs before activation.
        uses: actions/checkout@v4

      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy, rustfmt

      - name: Cache Cargo dependencies
        uses: Swatinem/rust-cache@v2

      - name: Enforce Code Formatting
        run: cargo fmt --all --check

      - name: Enforce Zero Unsafe Code & Clippy Lints
        run: cargo clippy --locked --workspace --all-targets --all-features -- -D warnings -F unsafe-code

      - name: Build Documentation
        env:
          RUSTDOCFLAGS: "-D warnings"
        run: cargo doc --locked --workspace --all-features --no-deps

      - name: Run Cargo Audit (Dependency Vulnerabilities)
        uses: rustsec/audit-check-action@v1.4.1
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

  # =========================================================================
  # JOB 2: Test Suite (Multi-OS Matrix)
  # =========================================================================
  unit-and-integration-tests:
    name: Test Suite (${{ matrix.os }})
    needs: security-and-lint
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@stable

      - name: Cache Cargo dependencies
        uses: Swatinem/rust-cache@v2

      - name: Run Unit and Integration Tests
        run: cargo test --locked --all-features --workspace

  # =========================================================================
  # JOB 3: Cross-Compilation Matrix (Build Verification)
  # =========================================================================
  cross-compile:
    name: Cross-Compile (${{ matrix.target }})
    needs: security-and-lint
    strategy:
      fail-fast: false
      matrix:
        include:
          # Linux x86_64
          - target: x86_64-unknown-linux-gnu
            os: ubuntu-latest
            use-cross: false
          # Linux ARM64 (e.g., Raspberry Pi 4 / Graviton)
          - target: aarch64-unknown-linux-gnu
            os: ubuntu-latest
            use-cross: true
          # Windows x86_64
          - target: x86_64-pc-windows-msvc
            os: windows-latest
            use-cross: false
          # macOS Apple Silicon (M1/M2/M3)
          - target: aarch64-apple-darwin
            os: macos-latest
            use-cross: false
    runs-on: ${{ matrix.os }}
    timeout-minutes: 45
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}

      - name: Cache Cargo dependencies
        uses: Swatinem/rust-cache@v2

      - name: Install 'cross' for ARM cross-compilation
        if: matrix.use-cross
        # TEMPLATE: select and pin a reviewed release before activation.
        run: cargo install cross --locked --version REPLACE_WITH_REVIEWED_VERSION

      - name: Build Target Binary (Standard Cargo)
        if: ${{ !matrix.use-cross }}
        run: cargo build --locked --release --target ${{ matrix.target }}

      - name: Build Target Binary (Cross Engine)
        if: matrix.use-cross
        run: cross build --locked --release --target ${{ matrix.target }}

      - name: Upload Binary Artifact
        uses: actions/upload-artifact@v4
        with:
          name: scanner-${{ matrix.target }}
          path: |
            target/${{ matrix.target }}/release/REPLACE_WITH_BINARY_NAME
            target/${{ matrix.target }}/release/REPLACE_WITH_BINARY_NAME.exe
          if-no-files-found: error
