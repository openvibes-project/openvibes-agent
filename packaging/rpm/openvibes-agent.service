[Unit]
Description=OpenVIBES endpoint agent
Documentation=https://github.com/openvibes-project/openvibes-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=openvibes_agent
Group=openvibes_agent
ExecStart=/usr/bin/openvibes-agent /etc/openvibes-agent/agent.toml
# The agent has no signal handler; its SQLite state is crash-safe, so the
# default SIGTERM stop is correct.
Restart=on-failure
RestartSec=30s
StateDirectory=openvibes-agent
StateDirectoryMode=0700
UMask=0077
# Loading the eBPF program needs tens of MB of heap for a moment (the
# kernel's BTF). Freeing a large buffer raises glibc's dynamic malloc
# thresholds, and then that heap stays resident (17 MB measured); pinned at
# 128 KiB it goes back to the system. Other C libraries ignore it.
Environment=GLIBC_TUNABLES=glibc.malloc.mmap_threshold=131072:glibc.malloc.trim_threshold=131072
NoNewPrivileges=yes
# Process starts (P14): CAP_BPF and CAP_PERFMON load and attach the eBPF
# exec program and are dropped from every set right after; CAP_AUDIT_READ
# reads the audit multicast group when eBPF cannot load (the fallback). It
# cannot change audit rules or read /var/log/audit.
AmbientCapabilities=CAP_AUDIT_READ CAP_BPF CAP_PERFMON
CapabilityBoundingSet=CAP_AUDIT_READ CAP_BPF CAP_PERFMON
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# The eBPF watcher loads its program with bpf() and then drops CAP_BPF and
# CAP_PERFMON with capset() (both in @privileged); nothing else from that
# group. capset() can only lower capabilities here (no CAP_SETPCAP).
SystemCallFilter=bpf capset
# A blocked call fails with EPERM, so the agent falls back to audit instead
# of being killed (SIGSYS) into a restart loop.
SystemCallErrorNumber=EPERM
# Deliberately NOT set, because the agent inspects the host:
# - ProtectProc=invisible and ProcSubset=pid hide other users' processes and
#   /proc/net (process and port collectors);
# - PrivateNetwork: the agent talks to the platform, and listening ports are
#   read from the host's network namespace;
# - PrivateUsers: other users' processes would appear as nobody;
# - ProtectHostname: it freezes the hostname the agent reports at the value
#   it had when the service started (setting it is already prevented by
#   the capability set, which holds only CAP_AUDIT_READ once the eBPF
#   capabilities are dropped).

[Install]
WantedBy=multi-user.target
